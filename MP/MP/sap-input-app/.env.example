# ============================================================
# TEMPLATE ENVIRONMENT VARIABLES — sap-input-app
# ============================================================
# Salin file ini menjadi .env.local (untuk dev lokal) atau .env.production
# JANGAN isi nilai asli di sini. File ini BOLEH di-commit ke Git.
# ============================================================

# --- SUPABASE ---
# DEV:  https://devpmreg5.afratarigan.my.id
# PROD: https://pmreg5.afratarigan.my.id
VITE_SUPABASE_URL=

# Anon key dari PostgREST server (berbeda antara DEV dan PROD)
VITE_SUPABASE_ANON_KEY=

# --- APP ---
# 'dev' untuk DEV, 'production' untuk PROD
VITE_APP_ENV=dev
VITE_APP_BASE_URL=
APP_URL=

# --- WHATSAPP (DEV ONLY) ---
# Isi dengan nomor WA pribadi Anda untuk menerima pesan test
# Contoh: 6281234567890@s.whatsapp.net
DEV_TARGET_WA=
TARGET_GROUP_JIDS=

# --- DEV AUTH (Nginx Basic Auth, hanya untuk devpmreg5) ---
HTTP_AUTH_USER=
HTTP_AUTH_PASS=

# --- DEPLOY SSH (untuk deploy_both.mjs) ---
# Direkomendasikan: gunakan SSH key daripada password
# SSH_KEY_PATH=/home/user/.ssh/id_rsa
SSH_HOST=
SSH_USER=ubuntu
SSH_PASS=
